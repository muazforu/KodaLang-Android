# Copy this file to `local.properties` and fill in your own values.
# local.properties is git-ignored — NEVER commit real keys.
#
# Where to find the anon key:
#   1. Your KodaLang web project's .env  ->  VITE_SUPABASE_PUBLISHABLE_KEY, or
#   2. Supabase dashboard -> your project -> Project Settings -> API -> "anon public" key.

# Supabase project shared with kodalang.com
SUPABASE_URL=https://tsvfdzkelmznxqlcvrjb.supabase.co
SUPABASE_ANON_KEY=PASTE_YOUR_ANON_KEY_HERE

# Base URL of the KodaLang web app (hosts /api/tutor-chat and /api/tutor-tts)
API_BASE=https://kodalang.com
